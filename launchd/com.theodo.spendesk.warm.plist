<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the Spendesk session from going cold.

  The session is not a fixed lifetime, it slides: a captured HAR shows it surviving 1h42
  of idle and then dying after 1h17, with no refresh endpoint called anywhere. It stays
  alive because the app keeps making requests. The daily job is 24 hours of silence, so it
  always found a dead session and degraded to the payable path — losing descriptions and
  the day-0 window.

  30 minutes is deliberately well inside the shortest observed window, since the cost of a
  ping is one HTTP request and the cost of being wrong is a blocked card. Adjust once
  logs/runs.jsonl shows how long it actually holds.

  RunAtLoad is on: after a reboot or a login the session should be warmed immediately
  rather than up to half an hour later.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theodo.spendesk.warm</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/waltoss/.bun/bin/bun</string>
    <string>src/index.ts</string>
    <string>keep-warm</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/waltoss/Code/Theodo/Playground/spendesk-auto</string>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/waltoss/Code/Theodo/Playground/spendesk-auto/logs/warm.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/waltoss/Code/Theodo/Playground/spendesk-auto/logs/warm.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/waltoss/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
